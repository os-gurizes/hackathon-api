{
  "name": "api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:pull": "drizzle-kit pull --config drizzle.analytics.config.ts && tsx scripts/clean-analytics-schema.ts && prettier --write src/db/analytics",
    "db:generate": "drizzle-kit generate --config drizzle.app.config.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "openapi": "tsx scripts/export-openapi.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/etag": "^6.2.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.23.1",
    "typebox": "^1.4.2"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
